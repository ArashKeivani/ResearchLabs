# Optional Docker bridge settings. Pick unused private ranges if these overlap
# with a VPN, LAN, or another Docker network. Recreate the network after edits.
LAB_SUBNET=172.29.250.0/24
LAB_GATEWAY=172.29.250.1
PAYLOAD_SUBNET=172.30.250.0/24
PAYLOAD_GATEWAY=172.30.250.1

# Host-side payload-server port used by exploit-location-xss.py.
LAB_PAYLOAD_PORT=8082

# In-memory cache lifetime in seconds.
CACHE_TTL_SECONDS=600
